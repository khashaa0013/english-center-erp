# =====================================================================
# Англи хэлний сургалтын төвийн ERP — Backend тохиргооны ЗАГВАР
#
# Энэ файлыг хуулж ".env" нэртэй болгоод CHANGE_ME утгуудыг солино.
# Энэ файл Git-д ОРНО — тиймээс энд ЖИНХЭНЭ нууц үг БИЧИХГҮЙ.
# =====================================================================

# ----- Сервер -----
NODE_ENV=development
PORT=5000
APP_TIMEZONE="Asia/Ulaanbaatar"

# ----- Database (XAMPP MariaDB 10.4) -----
# Формат: mysql://ХЭРЭГЛЭГЧ:НУУЦ_ҮГ@ХОСТ:ПОРТ/DATABASE_НЭР
# Порт: XAMPP-ийн my.ini дээр шалгасан утга (3306)
DATABASE_URL="mysql://erp_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/english_center_erp"
SHADOW_DATABASE_URL="mysql://erp_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:3306/english_center_erp_shadow"

# ----- Нэвтрэлт (JWT) -----
# 64+ тэмдэгттэй санамсаргүй мөр. Үүсгэх команд: Алхам 4.4-т
JWT_SECRET="CHANGE_ME_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=10

# ----- CORS (React frontend-ийн хаяг) -----
CORS_ORIGIN="http://localhost:5173"

# ----- Файл upload -----
UPLOAD_DIR="uploads"
UPLOAD_MAX_FILE_SIZE_MB=10

# ----- PDF (гэрээ, гэрчилгээ) -----
# Кирилл үсэгтэй TTF фонт. Хоосон бол Windows-ийн Arial ашиглана.
# PDF_FONT_PATH="C:/Windows/Fonts/arial.ttf"

# ----- Гэрчилгээний QR-д бичих frontend хаяг -----
PUBLIC_APP_URL="http://localhost:5173"

# ----- QPay (туршилтын callback) -----
# Хоосон бол /api/public/qpay/callback хаалттай. Бодит QPay-д гэрээ, client id/secret шаардлагатай.
QPAY_WEBHOOK_SECRET=""

# ----- Seed (npm run db:seed) -----
# Захирлын (admin) анхны нууц үг. Хоосон бол хөгжүүлэлтийн "Admin12345!"
# SEED_ADMIN_PASSWORD="CHANGE_ME_ADMIN_PASSWORD"
